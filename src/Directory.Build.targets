<Project>

  <!-- A Directory.Build.targets here hides any above it, unless it imports it. -->
  <PropertyGroup>
    <_ParentDirectoryBuildTargets>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))</_ParentDirectoryBuildTargets>
  </PropertyGroup>
  <Import Project="$(_ParentDirectoryBuildTargets)" Condition="'$(_ParentDirectoryBuildTargets)' != ''" />

  <!--
    Every package's README is its project's own README.md. An Update, and here rather than in the props:
    the SDK's default glob has already made the file a None item by the time targets are read, and a
    second Include would pack it twice. A package without one does not pack at all: NuGet refuses a
    PackageReadmeFile that is not in the package (NU5039).
  -->
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The engine depends on the base class library alone. This reads the project's evaluated
    PackageReference items, so a reference is caught wherever it was declared: the project, a
    Directory.Build.props above it, or an import. Only what the SDK adds by itself (IsImplicitlyDefined,
    such as the ILLink tasks a trimmed or native publish brings) is let through. It runs before the
    references are collected, so a restore fails as early as a build.
  -->
  <Target Name="_RefuseThirdPartyPackages" BeforeTargets="CollectPackageReferences">
    <ItemGroup>
      <_ThirdPartyPackage Include="@(PackageReference)" Condition="'%(PackageReference.IsImplicitlyDefined)' != 'true'" />
    </ItemGroup>
    <Error Condition="'@(_ThirdPartyPackage)' != ''"
           Code="EQIMG001"
           Text="$(MSBuildProjectName) references @(_ThirdPartyPackage->'%(Identity)', ', '): a package under src/ depends on the .NET base class library alone." />
  </Target>

</Project>
